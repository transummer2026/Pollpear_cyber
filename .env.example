# Secrets et config versés dans Vault par seed.sh (monté RO dans le seul conteneur vault).
# Copier en .env dans ce repo. Rien d'autre ne lit ce fichier.

# --- Commun (tous environnements) ---
POSTGRES_USER="pollpear"
POSTGRES_DB="pollpear"
POSTGRES_PASSWORD="pollpear"

NESTJS_PEPPER="saltybitches"
# API_KEYS_PEPPER="change-me-openssl-rand-hex-32"

GRAFANA_USER="admin"
GRAFANA_PASSWORD="machin"

BACKEND_URL="http://backend:3000"
NESTJS_PORT="3000"
REDIS_PASSWORD="pollpear"

MAIL_HOST="mail.infomaniak.com"
MAIL_PORT="587"
MAIL_USER="info@pollpear.com"
MAIL_PASS="CHANGE-ME"
MAIL_FROM="Pollpear <no-reply@pollpear.com>"

OAUTH_42_CLIENT_ID="CHANGE-ME"
OAUTH_42_CLIENT_SECRET="CHANGE-ME"
OAUTH_42_REDIRECT_URI="CHANGE-ME"

OAUTH_GITHUB_CLIENT_ID="CHANGE-ME"
OAUTH_GITHUB_CLIENT_SECRET="CHANGE-ME"
OAUTH_GITHUB_REDIRECT_URI="CHANGE-ME"

OAUTH_GOOGLE_CLIENT_ID="CHANGE-ME"
OAUTH_GOOGLE_CLIENT_SECRET="CHANGE-ME"
OAUTH_GOOGLE_REDIRECT_URI="CHANGE-ME"

# Garage (S3 object storage) ; secrets à générer une fois (commande au-dessus de chaque)
# openssl rand -hex 32
GARAGE_RPC_SECRET="CHANGE-ME"
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN="CHANGE-ME"
GARAGE_S3_ENDPOINT="http://garage:3900"
GARAGE_S3_URL="http://garage:3902"
GARAGE_S3_UPLOADS_HOST="pollpear-uploads.web.garage.localhost"
GARAGE_S3_REGION="garage"
GARAGE_S3_BUCKET="pollpear-uploads"
# echo "GK$(openssl rand -hex 12)"
GARAGE_S3_ACCESS_KEY="CHANGE-ME"
# openssl rand -hex 32
GARAGE_S3_SECRET_KEY="CHANGE-ME"

# WebSocket ; décommenter pour surcharger les défauts du seed
#WS_PATH="/ws"
#WS_PING_INTERVAL="25000"
#WS_PING_TIMEOUT="20000"
#WS_MAX_PAYLOAD="1000000"

# --- Dev (défaut) ---
FRONTEND_URL="http://localhost:5173"
GATEWAY_URL="http://localhost:8080/api"
OAUTH_42_REDIRECT_URI="http://localhost:3000/auth/oauth/school42/callback"
OAUTH_GOOGLE_REDIRECT_URI="http://localhost:3000/auth/oauth/google/callback"
OAUTH_GITHUB_REDIRECT_URI="http://localhost:3000/auth/oauth/github/callback"

